{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AfterGrid prototype theme package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "theme_api",
    "version",
    "author",
    "license",
    "theme"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "theme_api": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "radius",
        "light",
        "dark"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(local|community)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "light": {
          "$ref": "#/$defs/palette"
        },
        "dark": {
          "$ref": "#/$defs/palette"
        }
      }
    }
  },
  "$defs": {
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bg",
        "panel",
        "sidebar",
        "text",
        "muted",
        "accent",
        "onAccent",
        "border",
        "hero"
      ],
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "panel": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "sidebar": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "onAccent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hero": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    }
  }
}
